{
    "name": "cinnamon-secrets-app",
    "version": "1.0.0",
    "description": "A simple bakery management app for Cinnamon Secrets.",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "pack": "electron-builder",
        "dist:win": "electron-builder --win nsis"
    },
    "devDependencies": {
        "electron": "^23.1.0",
        "electron-builder": "^24.13.3"
    },
    "build": {
        "appId": "com.yourdomain.cinnamonsecrets",
        "productName": "Cinnamon Secrets",
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "**/*",
            "!dist/**/*",
            "!node_modules/.cache/**/*"
        ],
        "extraResources": [
            "demo-snapshot.json"
        ],
        "mac": {
            "category": "public.app-category.utilities",
            "icon": "build/logo_mac.icns"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/logo_win.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowElevation": true,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Cinnamon Secrets",
            "artifactName": "Cinnamon Secrets Setup ${version}.${ext}"
        }
    },
    "dependencies": {
        "better-sqlite3": "^12.5.0"
    }
}